# Copy to backend/.env and fill in. Never commit real .env files.

# Neon dev branch. Paste the URLs from the Neon console as-is.
# Pooled endpoint (host contains -pooler) for the app:
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/nexora?sslmode=require
# Direct endpoint for Alembic migrations:
MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/nexora?sslmode=require

# Offline alternative (local Postgres or the optional docker-compose service):
# DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora
# MIGRATION_DATABASE_URL=

CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# Firebase Authentication (M1). Auth is Firebase-only: no JWT secret.
FIREBASE_PROJECT_ID=
