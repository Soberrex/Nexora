# Copy to backend/.env and fill in. Never commit real .env files.

# Neon dev branch. Paste the URLs from the Neon console as-is.
# Pooled endpoint (host contains -pooler) for the app:
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/nexora?sslmode=require
# Direct endpoint for Alembic migrations:
MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/nexora?sslmode=require

# Local development (default until deployment): local PostgreSQL created by infra/local/create_local_db.sql
# DATABASE_URL=postgresql://nexora:nexora_local_dev@localhost:5432/nexora
TEST_DATABASE_URL=postgresql://nexora:nexora_local_dev@localhost:5432/nexora_test

CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# Firebase Authentication. Locally: emulator + demo project (no Firebase account needed).
FIREBASE_PROJECT_ID=demo-nexora
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
AUTH_REQUIRE_VERIFIED_EMAIL=false
