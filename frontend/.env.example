# Base URL of the FastAPI backend. Leave empty in local dev (Vite proxies /api).
# On Cloudflare Pages set it to the Render URL, e.g. https://nexora-api.onrender.com
VITE_API_BASE_URL=

# Local development uses the Firebase Auth Emulator (no Firebase account needed).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nexora.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nexora
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
